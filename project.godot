; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is readable so it is also fine to edit it by hand.

config_version=5

[application]

config/name="River Royale"
config/description="A battle royale where you play as a river. 80 rivers, one summit, one sea."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"

[debug]

file_logging/enable_file_logging=true
settings/stdout/print_fps=false
